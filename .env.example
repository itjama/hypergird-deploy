# Skopíruj: cp .env.example .env  — .env je v .gitignore, existuje iba na serveri.

# Verzia aplikácie = tag image v GHCR bez „v“ (git tag v0.1.0 → 0.1.0). ./deploy.sh 0.1.0 ju prepíše.
APP_VERSION=

# Doména bez https:// (DNS *.app.iteo.sk → IP VPS)
DOMAIN=hypergrid.app.iteo.sk

# Heslo PostgreSQL: openssl rand -hex 32  (hex nerozbije connection string)
# Pri existujúcom volume platí heslo z jeho prvého spustenia.
DB_PASSWORD=

# Kľúč na podpis tokenov hostí, aspoň 32 bajtov: openssl rand -base64 48
# Zmena kľúča zneplatní tokeny všetkých hostí.
GUEST_SIGNING_KEY=

# Koľko dní držať zálohy DB (backup.sh)
KEEP_DAYS=14
